# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DATABASE_URL=
# Initial setup only. Afterwards the database hash is authoritative; change it in /admin/guvenlik.
# Generate with pnpm admin:password. Escape bcrypt dollar signs as \$ for Next.js.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# VPS: local. Vercel: blob. Local storage is explicitly blocked on Vercel.
STORAGE_DRIVER=local
# Absolute path, outside the app release directory; owned by the app user.
UPLOAD_DIR=
BLOB_READ_WRITE_TOKEN=

# Only used by compose.yaml when hosting PostgreSQL locally/on the VPS.
DB_PASSWORD=

# Optional: no network calls or imports occur without credentials.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

NEXT_PUBLIC_SITE_URL=https://woyatablo.com
