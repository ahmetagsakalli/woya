# Server-only. Do not prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000
DATABASE_URL=
# Initial setup only. Afterwards the database hash is authoritative; change it in /admin/guvenlik.
# Generate with pnpm admin:password. Escape bcrypt dollar signs as \$ for Next.js.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# VPS: local. Vercel: blob. Local storage is explicitly blocked on Vercel.
STORAGE_DRIVER=local
# Absolute path, outside the app release directory; owned by the app user.
UPLOAD_DIR=
BLOB_READ_WRITE_TOKEN=

# Only used by compose.yaml when hosting PostgreSQL locally/on the VPS.
DB_PASSWORD=

# Optional: no network calls or imports occur without credentials.
TRENDYOL_SUPPLIER_ID=
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=

NEXT_PUBLIC_SITE_URL=https://woyatablo.com

# PayTR iFrame API. Keep disabled until database migration, public HTTPS callback,
# legal documents, shipping and an end-to-end PayTR test are verified.
PAYTR_ENABLED=false
PAYTR_TEST_MODE=1
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# VPS proxy must overwrite this single-IP header; block direct access to Node.
PAYTR_TRUSTED_IP_HEADER=x-real-ip
# Optional external IP for local test mode ONLY. Never use in live mode.
PAYTR_TEST_USER_IP=
# Integer kurus. Required below the free-shipping threshold; do not guess a fee.
CHECKOUT_SHIPPING_FEE_KURUS=
CHECKOUT_FREE_SHIPPING_KURUS=200000
# Published, reviewed legal document paths (not /iletisim); required in live mode.
CHECKOUT_TERMS_PATH=
CHECKOUT_INFORMATION_PATH=
CHECKOUT_LEGAL_VERSION=
